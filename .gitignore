# Raw dataset files (multi-GB)
dataset/**/*.tsv
dataset/*.zip
*.zip

# Generated intermediate artifacts and data
data/raw/*
data/interim/*
data/processed/*
*.parquet

# Output candidate and matching results (multi-hundred MB)
output/*.tsv
output/generated/*

# Large submission TSV files (preserve submission log)
submissions/*.tsv
!submissions/log.csv

# Keep directory structure
!.gitkeep